<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sửa điểm học sinh</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f1f5f9;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            background: #0f172a;
            position: fixed;
            top: 0;
            left: 0;
            padding: 20px;
            z-index: 1000;
        }

        .main-content {
            margin-left: 260px;
            flex: 1;
            padding: 40px;
            width: calc(100% - 260px);
        }

        .nav-link {
            color: #94a3b8;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 5px;
            text-decoration: none;
            display: block;
            transition: 0.3s;
        }

        .nav-link:hover,
        .nav-link.active {
            background: #1e293b;
            color: #fff !important;
        }

        .card-custom {
            border: none;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            background: white;
            padding: 40px;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <h4 class="text-white fw-bold mb-4 px-2">QL Hệ Thống</h4>
        <nav class="nav flex-column">
            <a href="/admin" class="nav-link"><i class="bi bi-speedometer2 me-2"></i> Tổng quan</a>
            <a href="/diem" class="nav-link active"><i class="bi bi-book me-2"></i> Quản lý điểm</a>
            <a href="/lop" class="nav-link"><i class="bi bi-door-open me-2"></i> Lớp học</a>
            <hr class="text-secondary opacity-25">
            <a href="/dangxuat" class="nav-link text-danger"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a>
        </nav>
    </div>

    <div class="main-content">
        <div class="card-custom">
            <h2 class="fw-bold text-primary mb-4"><i class="bi bi-pencil-square me-2"></i>Cập nhật điểm số</h2>

            <form action="/diem/sua/<%= diem._id %>" method="POST">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Học sinh</label>
                        <select name="HocSinh" class="form-select" required>
                            <% hocsinh.forEach(hs=> { %>
                                <option value="<%= hs._id %>" <%=diem.HocSinh.toString()==hs._id.toString() ? 'selected'
                                    : '' %>>
                                    <%= hs.HoVaTen %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Môn học</label>
                        <select name="MonHoc" class="form-select" required>
                            <% monhoc.forEach(mon=> { %>
                                <option value="<%= mon._id %>" <%=diem.MonHoc.toString()==mon._id.toString()
                                    ? 'selected' : '' %>>
                                    <%= mon.TenMon %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label">Điểm miệng</label>
                        <input type="number" step="0.1" name="DiemMieng" class="form-control"
                            value="<%= diem.DiemMieng %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Điểm 15 phút</label>
                        <input type="number" step="0.1" name="Diem15Phut" class="form-control"
                            value="<%= diem.Diem15Phut %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Điểm 1 tiết</label>
                        <input type="number" step="0.1" name="Diem1Tiet" class="form-control"
                            value="<%= diem.Diem1Tiet %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-danger fw-bold">Điểm thi</label>
                        <input type="number" step="0.1" name="DiemThi" class="form-control border-danger"
                            value="<%= diem.DiemThi %>">
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Học kỳ</label>
                        <select name="HocKy" class="form-select">
                            <option value="1" <%=diem.HocKy=='1' ? 'selected' : '' %>>Học kỳ 1</option>
                            <option value="2" <%=diem.HocKy=='2' ? 'selected' : '' %>>Học kỳ 2</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Năm học</label>
                        <input type="text" name="NamHoc" class="form-control" value="<%= diem.NamHoc %>">
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm">LƯU THAY
                        ĐỔI</button>
                    <a href="/diem" class="btn btn-outline-secondary px-4 rounded-pill">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</body>

</html>