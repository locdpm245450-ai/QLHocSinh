<!DOCTYPE html>
<html lang="vi">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>
		<%= title %> - Quản lý tài khoản
	</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
	<style>
		/* Thiết lập layout Flexbox để Sidebar và Nội dung nằm ngang hàng  */
		body {
			background: #f1f5f9;
			margin: 0;
			font-family: 'Segoe UI', sans-serif;
			display: flex;
			min-height: 100vh;
		}

		/* Sidebar cố định bên trái, có thanh cuộn riêng  */
		.sidebar {
			width: 260px;
			height: 100vh;
			background: #0f172a;
			position: fixed;
			top: 0;
			left: 0;
			padding: 20px;
			z-index: 1000;
			overflow-y: auto;
		}

		/* Đẩy nội dung sang phải 260px để tránh bị Sidebar che khuất  */
		.main-content {
			margin-left: 260px;
			flex: 1;
			padding: 40px;
			width: calc(100% - 260px);
		}

		.nav-link {
			color: #94a3b8;
			padding: 12px;
			border-radius: 10px;
			margin-bottom: 5px;
			text-decoration: none;
			display: block;
			transition: 0.3s;
		}

		.nav-link:hover,
		.nav-link.active {
			background: #1e293b;
			color: white !important;
		}

		.main-card {
			background: white;
			border-radius: 20px;
			padding: 30px;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
		}

		.avatar-mini {
			width: 45px;
			height: 45px;
			object-fit: cover;
			border-radius: 50%;
			border: 2px solid #cbd5e1;
		}

		.table thead {
			background: #0f172a;
			color: white;
		}
	</style>
</head>

<body>

	<div class="sidebar">
        <h4 class="text-white fw-bold mb-4 px-2">QL Học Sinh</h4>
        <nav class="nav flex-column">

            <a href="/admin" class="nav-link"><i class="bi bi-speedometer2 me-2"></i> Tổng quan</a>
            <a href="/taikhoan" class="nav-link active"><i class="bi bi-person-badge me-2"></i> Quản lý tài khoản</a>
            <a href="/hocsinh" class="nav-link "><i class="bi bi-people me-2"></i>Học sinh</a>
            <a href="/diem" class="nav-link"><i class="bi bi-book me-2"></i>Quản lý điểm</a>
			<a href="/monhoc" class="nav-link"><i class="bi bi-book me-2"></i>Môn học</a>
            <a href="/lop" class="nav-link "><i class="bi bi-door-open me-2"></i>Lớp học</a>
            <a href="/baitap" class="nav-link"><i class="bi bi-journal-text me-2"></i>Bài tập</a>
            <a href="/" class="nav-link"><i class="bi bi-house-door me-2"></i>Trang chủ</a>
            <hr class="text-secondary">
            <a href="/dangxuat" class="nav-link text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
        </nav>
    </div>

	<div class="main-content">
		<div class="main-card">
			<div class="d-flex justify-content-between align-items-center mb-4">
				<h2 class="fw-bold m-0"><i class="bi bi-people-fill text-primary"></i> Danh sách tài khoản</h2>
				<a href="/taikhoan/them" class="btn btn-primary px-4 rounded-pill fw-bold">+ Thêm mới</a>
			</div>

			<div class="table-responsive">
				<table class="table table-hover align-middle">
					<thead>
						<tr>
							<th class="text-center">#</th>
							<th>Họ và tên</th>
							<th>Email</th>
							<th class="text-center">Ảnh</th>
							<th>Tên đăng nhập</th>
							<th>Quyền hạn</th>
							<th class="text-center">Trạng thái</th>
							<th class="text-center">Thao tác</th>
						</tr>
					</thead>
					<tbody>
						<% var stt=1; %>
							<% taikhoan.forEach(tk=> { %>
								<tr>
									<td class="text-center">
										<%= stt++ %>
									</td>
									<td><b>
											<%= tk.HoVaTen %>
										</b></td>
									<td>
										<%= tk.Email %>
									</td>
									<td class="text-center">
										<img src="<%= tk.HinhAnh || '/images/default.png' %>" class="avatar-mini">
									</td>
									<td><span class="badge bg-light text-dark">
											<%= tk.TenDangNhap %>
										</span></td>
									<td>
										<span class="badge <%= tk.QuyenHan === 'admin' ? 'bg-danger' : 'bg-primary' %>">
											<%= tk.QuyenHan %>
										</span>
									</td>
									<td class="text-center">
										<% if(tk.KichHoat==1) { %>
											<i class="bi bi-check-circle-fill text-success fs-5"></i>
											<% } else { %>
												<i class="bi bi-x-circle-fill text-danger fs-5"></i>
												<% } %>
									</td>
									<td class="text-center">
										<div class="d-flex justify-content-center gap-2">
											<a href="/taikhoan/sua/<%= tk._id %>"
												class="btn btn-sm btn-outline-primary">
												<i class="bi bi-pencil-square"></i>
											</a>
											<a href="/taikhoan/xoa/<%= tk._id %>" class="btn btn-sm btn-outline-danger"
												onclick="return confirm('Xác nhận xóa tài khoản <%= tk.HoVaTen %>?');">
												<i class="bi bi-trash-fill"></i>
											</a>
										</div>
									</td>
								</tr>
								<% }); %>
					</tbody>
				</table>
			</div>
		</div>
	</div>

</body>

</html>