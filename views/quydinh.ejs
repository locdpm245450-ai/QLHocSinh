<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <title>Quy định nhà trường</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        body {
            background: #f1f5f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .main-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        }

        .title {
            font-size: 40px;
            font-weight: bold;
            color: #1e3a8a;
        }

        .sub {
            color: #64748b;
            font-size: 18px;
        }

        .rule-card {
            border: none;
            border-radius: 16px;
            padding: 20px;
            background: #f8fafc;
            transition: 0.3s;
        }

        .rule-card:hover {
            transform: translateY(-5px);
            background: #e2e8f0;
        }

        .btn-custom {
            border-radius: 12px;
            font-weight: bold;
        }
    </style>
</head>

<body>

<div class="container mt-5">

    <!-- HEADER GIỐNG GIỚI THIỆU -->
    <div class="main-card mb-4">

        <h1 class="title">
            📌 Quy định nhà trường
        </h1>

        <p class="sub">
            Các quy định giúp học sinh và giáo viên tuân thủ nội quy trường học.
        </p>

        <% if(session.QuyenHan==='admin' || session.QuyenHan==='giaovien'){ %>
            <a href="/quydinh/them" class="btn btn-primary btn-custom mt-3">
                + Thêm quy định
            </a>
        <% } %>

    </div>

    <!-- DANH SÁCH QUY ĐỊNH -->
    <div class="row g-3">

        <% quydinh.forEach(function(q){ %>

            <div class="col-md-6">

                <div class="rule-card">

                    <h5 class="fw-bold text-primary">
                        <%= q.tieude %>
                    </h5>

                    <p class="text-secondary">
                        <%= q.noidung %>
                    </p>

                    <% if(session.QuyenHan==='admin' || session.QuyenHan==='giaovien'){ %>

                        <a href="/quydinh/sua/<%= q.id %>" class="btn btn-warning btn-sm">
                            Sửa
                        </a>

                        <a href="/quydinh/xoa/<%= q.id %>" class="btn btn-danger btn-sm"
                           onclick="return confirm('Xóa quy định này?')">
                            Xóa
                        </a>

                    <% } %>

                </div>

            </div>

        <% }) %>

    </div>

</div>

</body>
</html>