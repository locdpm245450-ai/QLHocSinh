<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>
		<%= title %>
	</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
	<style>
		body {
			background: #f1f5f9;
			margin: 0;
			font-family: 'Segoe UI', sans-serif;
		}

		/* Sidebar cố định có thanh kéo */
		.sidebar {
			width: 260px;
			height: 100vh;
			background: #0f172a;
			position: fixed;
			top: 0;
			left: 0;
			display: flex;
			flex-direction: column;
			padding: 20px;
			z-index: 1000;
			overflow-y: auto;
			/* Khôi phục thanh kéo menu */
		}

		.main-content {
			margin-left: 260px;
			padding: 40px;
		}

		/* Menu điều hướng chuẩn Bootstrap icon */
		.nav-link {
			color: #94a3b8;
			padding: 12px;
			border-radius: 10px;
			margin-bottom: 5px;
			transition: 0.3s;
			text-decoration: none;
			display: flex;
			align-items: center;
		}

		.nav-link:hover,
		.nav-link.active {
			background: #1e293b;
			color: white !important;
		}

		.card-stat {
			border: none;
			border-radius: 15px;
		}

		.quick-card {
			border: none;
			border-radius: 15px;
			transition: 0.3s;
			text-decoration: none;
			color: inherit;
			display: block;
		}

		.quick-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
		}
	</style>
</head>

<body>
	<div class="sidebar">
		<h4 class="text-white fw-bold mb-4 px-2">QL Học Sinh</h4>
		<nav class="nav flex-column">

			<a href="/admin" class="nav-link active"><i class="bi bi-speedometer2 me-2"></i> Tổng quan</a>
			<a href="/taikhoan" class="nav-link"><i class="bi bi-person-badge me-2"></i> Quản lý tài khoản</a>
			<a href="/hocsinh" class="nav-link "><i class="bi bi-people me-2"></i>Học sinh</a>
			<a href="/diem" class="nav-link"><i class="bi bi-book me-2"></i> Quản lý điểm</a>
			<a href="/monhoc" class="nav-link"><i class="bi bi-book me-2"></i>Môn học</a>
			<a href="/lop" class="nav-link "><i class="bi bi-door-open me-2"></i>Lớp học</a>
			<a href="/baitap" class="nav-link"><i class="bi bi-journal-text me-2"></i>Bài tập</a>
			<a href="/" class="nav-link"><i class="bi bi-house-door me-2"></i>Trang chủ</a>
			<hr class="text-secondary">
			<a href="/dangxuat" class="nav-link text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
		</nav>
	</div>

	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
			rel="stylesheet" />
		<title>
			<%= title %> - Trang tin điện tử
		</title>
	</head>

	<body>
		<div class="container">
			<!-- Menu ngang -->
			<%- include('navbar') %>

				<!-- Nội dung chính -->
				<div class="card mt-3">
					<div class="card-header">
						<%= title %>
					</div>
					<div class="card-body">
						<form action="/taikhoan/sua/<%= taikhoan._id %>" method="post" class="needs-validation"
							novalidate>
							<div class="mb-3">
								<label for="HoVaTen" class="form-label">Họ và tên</label>
								<input type="text" class="form-control" id="HoVaTen" name="HoVaTen"
									value="<%= taikhoan.HoVaTen %>" required />
							</div>

							<div class="mb-3">
								<label for="Email" class="form-label">Email</label>
								<input type="email" class="form-control" id="Email" name="Email"
									value="<%= taikhoan.Email %>" />
							</div>

							<div class="mb-3">
								<label class="form-label" for="HinhAnh">Hình ảnh</label>
								<input type="text" class="form-control" id="HinhAnh" name="HinhAnh"
									value="<%= taikhoan.HinhAnh %>" placeholder="Tập tin ảnh đại diện" />
							</div>

							<div class="mb-3">
								<label for="TenDangNhap" class="form-label">Tên đăng nhập</label>
								<input type="text" class="form-control" id="TenDangNhap" name="TenDangNhap"
									value="<%= taikhoan.TenDangNhap %>" required />
							</div>

							<div class="mb-3">
								<label class="form-label" for="QuyenHan">Quyền hạn</label>

								<select class="form-select" id="QuyenHan" name="QuyenHan" required>
									<option value="admin" <%=taikhoan.QuyenHan=="admin" ? "selected" : "" %>>
										Quản trị viên
									</option>

									<option value="giaovien" <%=taikhoan.QuyenHan=="giaovien" ? "selected" : "" %>>
										Giáo viên
									</option>

									<option value="hocsinh" <%=taikhoan.QuyenHan=="hocsinh" ? "selected" : "" %>>
										Học sinh
									</option>
								</select>
							</div>

							<div class="mb-3">
								<label class="form-label" for="KichHoat">Kích hoạt</label>
								<div class="form-check">
									<input class="form-check-input" type="radio" name="KichHoat" id="KichHoat1"
										value="1" <%=taikhoan.KichHoat=="1" ? "checked" : "" %> required />
									<label class="form-check-label" for="KichHoat1">Kích hoạt</label>
								</div>
								<div class="form-check">
									<input class="form-check-input" type="radio" name="KichHoat" id="KichHoat0"
										value="0" <%=taikhoan.KichHoat=="0" ? "checked" : "" %> required />
									<label class="form-check-label" for="KichHoat0">Khóa tài khoản</label>
								</div>
							</div>

							<div class="mb-3">
								<label for="MatKhau" class="form-label">Mật khẩu</label>
								<input type="password" class="form-control" id="MatKhau" name="MatKhau" />
								<span class="d-block small text-primary">Bỏ trống nếu muốn giữ nguyên mật khẩu
									cũ.</span>
							</div>

							<div class="mb-3">
								<label for="XacNhanMatKhau" class="form-label">Xác nhận mật khẩu</label>
								<input type="password" class="form-control" id="XacNhanMatKhau" name="XacNhanMatKhau" />
								<span class="d-block small text-primary">Bỏ trống nếu muốn giữ nguyên mật khẩu
									cũ.</span>
							</div>

							<button type="submit" class="btn btn-primary"><i class="bi bi-cloud-arrow-up"></i> Cập nhật
								tài
								khoản</button>
						</form>
					</div>
				</div>

				<!-- Footer -->
				<%- include('footer') %>
		</div>

		<%- include('javascript') %>
	</body>

</html>