<!DOCTYPE html>
<html lang="vi">

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bài tập học tập</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f1f5f9;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar cố định bên trái */
        .sidebar {
            width: 260px;
            height: 100vh;
            background: #0f172a;
            position: fixed;
            top: 0;
            left: 0;
            padding: 20px;
            z-index: 1000;
        }

        /* Phần nội dung chính phải có margin-left bằng chiều rộng sidebar */
        .main-content {
            margin-left: 260px;
            flex: 1;
            padding: 40px;
            width: calc(100% - 260px);
            min-height: 100vh;
        }

        .nav-link {
            color: #94a3b8;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: 0.3s;
            text-decoration: none;
            display: block;
        }

        .nav-link:hover,
        .nav-link.active {
            background: #1e293b;
            color: #fff !important;
        }

        .card-baitap {
            border: none;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            background: white;
        }

        .rounded-pill-custom {
            border-radius: 50px !important;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <h4 class="text-white fw-bold mb-4 px-2">QL Học Sinh</h4>
        <nav class="nav flex-column">

            <a href="/admin" class="nav-link"><i class="bi bi-speedometer2 me-2"></i> Tổng quan</a>
            <a href="/taikhoan" class="nav-link"><i class="bi bi-person-badge me-2"></i> Quản lý tài khoản</a>
            <a href="/hocsinh" class="nav-link "><i class="bi bi-people me-2"></i>Học sinh</a>
            <a href="/diem" class="nav-link active"><i class="bi bi-book me-2"></i>Quản lý điểm</a>
            <a href="/monhoc" class="nav-link"><i class="bi bi-book me-2"></i>Môn học</a>
            <a href="/lop" class="nav-link "><i class="bi bi-door-open me-2"></i>Lớp học</a>
            <a href="/baitap" class="nav-link "><i class="bi bi-journal-text me-2"></i>Bài tập</a>
            <a href="/" class="nav-link"><i class="bi bi-house-door me-2"></i>Trang chủ</a>
            <hr class="text-secondary">
            <a href="/dangxuat" class="nav-link text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
        </nav>
    </div>

    <body>

        <div class="container">

            <div class="box">

                <h1 class="text-center mb-4">
                    Quản lý điểm học sinh
                </h1>

                <div class="top-btn">

                    <% if(session.QuyenHan=='admin' || session.QuyenHan=='giaovien' ) { %>

                        <a href="/diem/them" class="btn btn-primary">
                            + Thêm điểm
                        </a>

                        <% } %>

                            <a href="/" class="btn btn-secondary">
                                ← Trang chủ
                            </a>

                            <% if(session.QuyenHan=='admin' || session.QuyenHan=='giaovien' ) { %>

                                <a href="/admin" class="btn btn-dark">
                                    Trang quản lý
                                </a>

                                <% } %>

                </div>

                <table class="table table-bordered table-hover text-center align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>Học sinh</th>

                            <th>Môn học</th>

                            <th>Điểm miệng</th>

                            <th>Điểm 15 phút</th>

                            <th>Điểm 1 tiết</th>

                            <th>Điểm thi</th>

                            <th>Học kỳ</th>

                            <th>Năm học</th>

                            <% if(session.QuyenHan=='admin' || session.QuyenHan=='giaovien' ) { %>

                                <th>Chức năng</th>

                                <% } %>

                        </tr>

                    </thead>

                    <tbody>

                        <% dsDiem.forEach(function(d){ %>

                            <tr>

                                <td>
                                    <%= d.HocSinh ? d.HocSinh.HoVaTen : '' %>
                                </td>

                                <td>
                                    <%= d.MonHoc ? d.MonHoc.TenMon : '' %>
                                </td>

                                <td>
                                    <%= d.DiemMieng %>
                                </td>

                                <td>
                                    <%= d.Diem15Phut %>
                                </td>

                                <td>
                                    <%= d.Diem1Tiet %>
                                </td>

                                <td>
                                    <%= d.DiemThi %>
                                </td>

                                <td>
                                    <%= d.HocKy %>
                                </td>

                                <td>
                                    <%= d.NamHoc %>
                                </td>

                                <% if(session.QuyenHan=='admin' || session.QuyenHan=='giaovien' ) { %>

                                    <td>

                                        <a href="/diem/sua/<%= d._id %>" class="btn btn-warning btn-sm">
                                            Sửa
                                        </a>

                                        <a href="/diem/xoa/<%= d._id %>" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Xóa điểm này?')">

                                            Xóa

                                        </a>

                                    </td>

                                    <% } %>

                            </tr>

                            <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </body>

</html>