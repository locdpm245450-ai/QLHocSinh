<!DOCTYPE html>
<html lang="vi">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>
		<%= title %>
	</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
	<style>
		body {
			background: #f1f5f9;
			margin: 0;
			font-family: 'Segoe UI', sans-serif;
		}

		.sidebar {
			width: 260px;
			height: 100vh;
			background: #0f172a;
			position: fixed;
			top: 0;
			left: 0;
			display: flex;
			flex-direction: column;
			padding: 20px;
			z-index: 1000;
			overflow-y: auto;
		}

		.main-content {
			margin-left: 260px;
			padding: 40px;
		}

		.nav-link {
			color: #94a3b8;
			padding: 12px;
			border-radius: 10px;
			margin-bottom: 5px;
			transition: 0.3s;
			text-decoration: none;
			display: flex;
			align-items: center;
		}

		.nav-link:hover,
		.nav-link.active {
			background: #1e293b;
			color: white !important;
		}

		.card-stat {
			border: none;
			border-radius: 15px;
		}

		.quick-card {
			border: none;
			border-radius: 15px;
			transition: 0.3s;
			text-decoration: none;
			color: inherit;
			display: block;
		}

		.quick-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
		}
	</style>
</head>

<body>
	<div class="sidebar">
		<h4 class="text-white fw-bold mb-4 px-2">QL Học Sinh</h4>
		<nav class="nav flex-column">

			<a href="/admin" class="nav-link active"><i class="bi bi-speedometer2 me-2"></i> Tổng quan</a>
			<a href="/taikhoan" class="nav-link"><i class="bi bi-person-badge me-2"></i> Quản lý tài khoản</a>
			<a href="/hocsinh" class="nav-link "><i class="bi bi-people me-2"></i>Học sinh</a>
			<a href="/diem" class="nav-link"><i class="bi bi-book me-2"></i> Quản lý điểm</a>
			<a href="/monhoc" class="nav-link"><i class="bi bi-book me-2"></i>Môn học</a>
			<a href="/lop" class="nav-link "><i class="bi bi-door-open me-2"></i>Lớp học</a>
			<a href="/baitap" class="nav-link"><i class="bi bi-journal-text me-2"></i>Bài tập</a>
			<a href="/" class="nav-link"><i class="bi bi-house-door me-2"></i>Trang chủ</a>
			<hr class="text-secondary">
			<a href="/dangxuat" class="nav-link text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
		</nav>
	</div>

	<div class="main-content">
		<h2 class="fw-bold mb-4 text-dark">Bảng điều khiển</h2>

		<div class="row g-4">
			<div class="col-md-4">
				<div class="card card-stat bg-primary text-white p-4 shadow-sm">
					<div class="d-flex justify-content-between align-items-center">
						<div>
							<p class="mb-1 opacity-75">Tổng học sinh</p>
							<h1 class="fw-bold m-0">
								<%= tsHS %>
							</h1>
						</div>
						<i class="bi bi-people fs-1 opacity-50"></i>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="card card-stat bg-success text-white p-4 shadow-sm">
					<div class="d-flex justify-content-between align-items-center">
						<div>
							<p class="mb-1 opacity-75">Tổng lớp học</p>
							<h1 class="fw-bold m-0">
								<%= tsLop %>
							</h1>
						</div>
						<i class="bi bi-door-open fs-1 opacity-50"></i>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="card card-stat bg-info text-white p-4 shadow-sm">
					<div class="d-flex justify-content-between align-items-center">
						<div>
							<p class="mb-1 opacity-75">Môn học</p>
							<h1 class="fw-bold m-0">
								<%= tsMon %>
							</h1>
						</div>
						<i class="bi bi-book fs-1 opacity-50"></i>
					</div>
				</div>
			</div>
		</div>

		<h4 class="fw-bold mb-3 mt-5">Thao tác nhanh</h4>
		<div class="row g-4">
			<div class="col-md-3">
				<a href="/taikhoan" class="card quick-card shadow-sm p-4 text-center border">
					<i class="bi bi-person-gear fs-1 text-primary"></i>
					<h6 class="mt-3 fw-bold text-dark">Quản lý tài khoản</h6>
				</a>
			</div>
			<div class="col-md-3">
				<a href="/monhoc" class="card quick-card shadow-sm p-4 text-center border">
					<i class="bi bi-journal-plus fs-1 text-success"></i>
					<h6 class="mt-3 fw-bold text-dark">Danh mục môn học</h6>
				</a>
			</div>
			<div class="col-md-3">
				<a href="/lich" class="card quick-card shadow-sm p-4 text-center border">
					<i class="bi bi-calendar-event fs-1 text-warning"></i>
					<h6 class="mt-3 fw-bold text-dark">Lịch sự kiện</h6>
				</a>
			</div>
		</div>
	</div>
</body>

</html>