<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lịch thi học kỳ</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f1f5f9;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            background: #0f172a;
            position: fixed;
            top: 0;
            left: 0;
            padding: 20px;
            z-index: 1000;
            overflow-y: auto;
        }

        .main-content {
            margin-left: 260px;
            flex: 1;
            padding: 40px;
            width: calc(100% - 260px);
        }

        .nav-link {
            color: #94a3b8;
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 5px;
            transition: 0.3s;
            text-decoration: none;
            display: flex;
            align-items: center;
        }

        .nav-link:hover,
        .nav-link.active {
            background: #1e293b;
            color: white !important;
        }

        .main-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }

        .table-custom thead {
            background: #0d6efd;
            color: white;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <h4 class="text-white fw-bold mb-4 px-2">QL Học Sinh</h4>
        <nav class="nav flex-column">
            <a href="/admin" class="nav-link"><i class="bi bi-speedometer2 me-2"></i> Tổng quan</a>
            <a href="/hocsinh" class="nav-link"><i class="bi bi-people me-2"></i>Học sinh</a>
            <a href="/diem" class="nav-link"><i class="bi bi-journal-check me-2"></i> Quản lý điểm</a>
            <a href="/lichthi" class="nav-link active"><i class="bi bi-calendar-event me-2"></i>Lịch thi</a>
            <a href="/" class="nav-link"><i class="bi bi-house-door me-2"></i>Trang chủ</a>
            <hr class="text-secondary">
            <a href="/dangxuat" class="nav-link text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
        </nav>
    </div>

    <div class="main-content">
        <div class="main-card">
            <h1 class="text-center fw-bold text-primary mb-4">Lịch thi học kỳ</h1>

            <div class="d-flex gap-2 mb-4 justify-content-center">
                <% if(session && (session.QuyenHan==='admin' || session.QuyenHan==='giaovien' )){ %>
                    <a href="/lichthi/them" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-plus-circle me-2"></i>Thêm lịch thi
                    </a>
                    <% } %>
                        <a href="/" class="btn btn-outline-secondary rounded-pill px-4">Trang chủ</a>
            </div>

            <div class="table-responsive rounded-3">
                <table class="table table-hover align-middle table-custom">
                    <thead>
                        <tr class="text-center">
                            <th>STT</th>
                            <th>Mã môn</th>
                            <th>Tên môn</th>
                            <th>Kỳ thi</th>
                            <th>Phòng thi</th>
                            <th>Ngày thi</th>
                            <th>Tiết BD</th>
                            <th>Số tiết</th>
                            <% if(session && (session.QuyenHan==='admin' || session.QuyenHan==='giaovien' )){ %>
                                <th>Thao tác</th>
                                <% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% lichthi.forEach(function(lt, i){ %>
                            <tr class="text-center">
                                <td>
                                    <%= i + 1 %>
                                </td>
                                <td class="fw-bold">
                                    <%= lt.maMon %>
                                </td>
                                <td class="text-start">
                                    <%= lt.tenMon %>
                                </td>
                                <td><span class="badge bg-info text-dark">
                                        <%= lt.kyThi %>
                                    </span></td>
                                <td>
                                    <%= lt.phongThi %>
                                </td>
                                <td class="text-primary fw-bold">
                                    <%= lt.ngayThi %>
                                </td>
                                <td>
                                    <%= lt.tietBatDau %>
                                </td>
                                <td>
                                    <%= lt.soTiet %>
                                </td>
                                <% if(session && (session.QuyenHan==='admin' || session.QuyenHan==='giaovien' )){ %>
                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <a href="/lichthi/sua/<%= lt._id %>" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a href="/lichthi/xoa/<%= lt._id %>" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Xóa lịch thi này?')">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                    <% } %>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>

</html>