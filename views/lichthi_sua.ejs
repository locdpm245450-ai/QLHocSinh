<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8" />
  <title>Sửa lịch thi</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <style>
    body {
      background: #f1f5f9;
      display: flex;
      min-height: 100vh;
      font-family: "Segoe UI", sans-serif;
    }

    .sidebar {
      width: 260px;
      background: #0f172a;
      padding: 20px;
      position: fixed;
      height: 100%;
    }

    .main {
      margin-left: 260px;
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 40px;
    }

    .form-card {
      width: 600px;
      background: white;
      padding: 40px;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .form-control {
      border-radius: 10px;
      padding: 10px;
    }
  </style>
</head>

<body>
  <div class="sidebar">
    <h4 class="text-white fw-bold mb-4 px-2">QL Học Sinh</h4>
    <a href="/lichthi" class="nav-link text-white text-decoration-none"><i class="bi bi-arrow-left"></i> Quay lại</a>
  </div>

  <div class="main">
    <div class="form-card">
      <h3 class="text-center fw-bold text-warning mb-4">✏️ Sửa lịch thi</h3>
      <form action="/lichthi/sua/<%= id %>" method="POST">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-bold">Mã môn [cite: 142]</label>
            <input type="text" name="maMon" value="<%= data.maMon %>" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Tên môn [cite: 143]</label>
            <input type="text" name="tenMon" value="<%= data.tenMon %>" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Kỳ thi [cite: 143]</label>
            <input type="text" name="kyThi" value="<%= data.kyThi %>" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Phòng thi [cite: 144]</label>
            <input type="text" name="phongThi" value="<%= data.phongThi %>" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Số lượng [cite: 145]</label>
            <input type="number" name="soLuong" value="<%= data.soLuong %>" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Ngày thi [cite: 146]</label>
            <input type="date" name="ngayThi" value="<%= data.ngayThi %>" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-bold">Tiết BD [cite: 146]</label>
            <input type="number" name="tietBatDau" value="<%= data.tietBatDau %>" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-bold">Số tiết [cite: 147]</label>
            <input type="number" name="soTiet" value="<%= data.soTiet %>" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-bold">Phòng [cite: 148]</label>
            <input type="text" name="phong" value="<%= data.phong %>" class="form-control" required>
          </div>
        </div>
        <div class="mt-4 text-center">
          <button class="btn btn-warning rounded-pill px-5 fw-bold py-2">CẬP NHẬT</button>
        </div>
      </form>
    </div>
  </div>
</body>

</html>