<div class="main-content">
    <div class="card-custom" style="max-width: 600px; margin: auto;">
        <h3 class="fw-bold text-primary mb-4">Ghi nhận hạnh kiểm</h3>
        <form action="/hanhkiem/them" method="POST">
            <div class="mb-3">
                <label class="form-label fw-bold">Chọn học sinh</label>
                <select name="MaHocSinh" class="form-select" required>
                    <% dsHocSinh.forEach(hs=> { %>
                        <option value="<%= hs._id %>">
                            <%= hs.HoVaTen %> (ID: <%= hs.TenDangNhap %>)
                        </option>
                        <% }) %>
                </select>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Học kỳ</label>
                    <select name="HocKy" class="form-select">
                        <option value="HK1">Học kỳ 1</option>
                        <option value="HK2">Học kỳ 2</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Năm học</label>
                    <input type="text" name="NamHoc" class="form-control" placeholder="2025-2026" required>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Điểm rèn luyện</label>
                <input type="number" name="Diem" class="form-control" min="0" max="100" required>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Ghi chú</label>
                <textarea name="GhiChu" class="form-control" rows="3"></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-100 fw-bold py-2 rounded-pill">LƯU HẠNH KIỂM</button>
        </form>
    </div>
</div>