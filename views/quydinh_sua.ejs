<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <title>Sửa quy định</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <style>
      body {
        background: #f1f5f9;
        font-family: "Segoe UI", sans-serif;
      }

      .center-box {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .card-form {
        width: 600px;
        border-radius: 20px;
        padding: 30px;
        background: white;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      }

      .title {
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 20px;
        text-align: center;
        color: #dc2626;
      }

      .form-control {
        border-radius: 12px;
      }

      .btn-custom {
        border-radius: 12px;
        font-weight: bold;
      }
    </style>
  </head>

  <body>
    <div class="center-box">
      <div class="card-form">
        <div class="title">✏️ Sửa quy định</div>

        <form method="POST" action="/quydinh/sua/<%= qd.id %>">
          <div class="mb-3">
            <label>Tiêu đề</label>
            <input
              type="text"
              name="tieude"
              class="form-control"
              value="<%= qd.tieude %>"
              required
            />
          </div>

          <div class="mb-3">
            <label class="form-label fw-bold text-secondary"
              >Đính kèm tài liệu (Dưới 15MB)</label
            >
            <input type="file" name="fileDinhKem" class="form-control" />
          </div>

          <div class="mb-3">
            <label>Nội dung</label>
            <textarea name="noidung" class="form-control" rows="5" required>
<%= qd.noidung %></textarea
            >
          </div>

          <button class="btn btn-success w-100 btn-custom">Cập nhật</button>

          <a href="/quydinh" class="btn btn-secondary w-100 mt-2 btn-custom">
            Quay lại
          </a>
        </form>
      </div>
    </div>
  </body>
</html>
