<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <title>Sửa lịch</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="container mt-5">
      <h3>Sửa nội dung lịch</h3>

      <form action="/lich/sua/<%= id %>" method="POST">
        <div class="mb-3">
          <label>Nội dung</label>
          <input
            type="text"
            name="noidung"
            class="form-control"
            value="<%= data ? data.noidung : '' %>"
            required
          />
        </div>

        <button class="btn btn-primary">Lưu</button>
        <a href="/lich" class="btn btn-secondary">Quay lại</a>
      </form>
    </div>
  </body>
</html>
