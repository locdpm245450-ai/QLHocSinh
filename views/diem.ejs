<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
        <%= typeof title !=='undefined' ? title : 'Quản lý điểm học sinh' %>
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f1f5f9;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR CỐ ĐỊNH BÊN TRÁI */
        .sidebar {
            width: 260px;
            height: 100vh;
            background: #0f172a;
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            padding: 20px;
            z-index: 1000;
            overflow-y: auto;
        }

        /* PHẦN NỘI DUNG CHÍNH - ĐẨY SANG PHẢI 260PX */
        .main-content {
            margin-left: 260px;
            flex: 1;
            padding: 40px;
            width: calc(100% - 260px);
        }

        .nav-link {
            color: #94a3b8;
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 5px;
            transition: 0.3s;
            text-decoration: none;
            display: flex;
            align-items: center;
        }

        .nav-link:hover,
        .nav-link.active {
            background: #1e293b;
            color: white !important;
        }

        .main-card {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }

        /* TÙY CHỈNH BẢNG ĐIỂM */
        .table-dark-custom thead {
            background: #212529;
            color: white;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <h4 class="text-white fw-bold mb-4 px-2">QL Học Sinh</h4>
        <nav class="nav flex-column">
            <a href="/admin" class="nav-link"><i class="bi bi-speedometer2 me-2"></i> Tổng quan</a>
            <a href="/taikhoan" class="nav-link"><i class="bi bi-person-badge me-2"></i> Quản lý tài khoản</a>
            <a href="/hocsinh" class="nav-link"><i class="bi bi-people me-2"></i>Học sinh</a>
            <a href="/diem" class="nav-link active"><i class="bi bi-journal-check me-2"></i> Quản lý điểm</a>
            <a href="/monhoc" class="nav-link"><i class="bi bi-book me-2"></i>Môn học</a>
            <a href="/lop" class="nav-link"><i class="bi bi-door-open me-2"></i>Lớp học</a>
            <a href="/baitap" class="nav-link"><i class="bi bi-journal-text me-2"></i>Bài tập</a>
            <a href="/" class="nav-link"><i class="bi bi-house-door me-2"></i>Trang chủ</a>
            <hr class="text-secondary">
            <a href="/dangxuat" class="nav-link text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
        </nav>
    </div>

    <div class="main-content">
        <div class="main-card">
            <h1 class="text-center fw-bold text-primary mb-4">Quản lý điểm học sinh</h1>

            <div class="d-flex gap-2 mb-4 justify-content-center">
                <a href="/diem/them" class="btn btn-primary rounded-pill px-4 fw-bold"><i
                        class="bi bi-plus-circle me-2"></i>Thêm điểm</a>

            </div>

            <div class="table-responsive rounded-3">
                <table class="table table-hover align-middle table-dark-custom">
                    <thead>
                        <tr class="text-center">
                            <th>STT</th>
                            <th>Mã HS</th>
                            <th>Học sinh</th>
                            <th>Môn học</th>
                            <th>Miệng</th>
                            <th>15 phút</th>
                            <th>1 tiết</th>
                            <th>Thi</th>
                            <th>Học kỳ</th>
                            <th>Năm học</th>
                            <th>Chức năng</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% dsDiem.forEach((d, index)=> { %>
                            <tr class="text-center">
                                <td>
                                    <%= index + 1 %>
                                </td>
                                <td class="fw-bold text-primary">
                                    <%= d.MaHocSinh %>
                                </td>

                                <td class="text-start fw-bold">
                                    <%= d.TenHocSinh %>
                                </td>
                                <td>
                                    <%= d.TenMonHoc %>
                                </td>
                                <td>
                                    <%= d.DiemMieng %>
                                </td>
                                <td>
                                    <%= d.Diem15Phut %>
                                </td>
                                <td>
                                    <%= d.Diem1Tiet %>
                                </td>
                                <td class="text-danger fw-bold">
                                    <%= d.DiemThi %>
                                </td>
                                <td>
                                    <%= d.HocKy %>
                                </td>
                                <td>
                                    <%= d.NamHoc %>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="/diem/sua/<%= d._id %>" class="btn btn-sm btn-outline-primary"><i
                                                class="bi bi-pencil-square"></i></a>
                                        <a href="/diem/xoa/<%= d._id %>" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Xóa điểm này?')"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>