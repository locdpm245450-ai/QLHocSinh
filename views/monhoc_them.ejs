<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <title>Thêm môn học</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="bg-light">

    <div class="container mt-5">

        <div class="card shadow-lg border-0 rounded-4 p-4">

            <h2 class="mb-4 text-success fw-bold">
                📚 Thêm môn học
            </h2>

            <form action="/monhoc/them" method="POST">

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Mã môn
                    </label>

                    <input type="text" name="MaMon" class="form-control" placeholder="VD: CT101" required>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Tên môn
                    </label>

                    <input type="text" name="TenMon" class="form-control" placeholder="Nhập tên môn học" required>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Số tín chỉ
                    </label>

                    <input type="number" name="SoTinChi" class="form-control" placeholder="VD: 3">

                </div>

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Giáo viên
                    </label>

                    <input type="text" name="GiangVien" class="form-control" placeholder="Tên giáo viên">

                </div>

                <div class="d-flex gap-2">

                    <button class="btn btn-success">
                        ➕ Thêm môn học
                    </button>

                    <a href="/monhoc" class="btn btn-secondary">
                        ← Quay lại
                    </a>

                </div>

            </form>

        </div>

    </div>

</body>

</html>