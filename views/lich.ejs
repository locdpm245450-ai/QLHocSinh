<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <title>Lịch sự kiện</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        body {
            background: #f1f5f9;
            font-family: Arial, sans-serif;
        }

        .calendar-container {
            background: white;
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 10px;
        }

        .day-name {
            background: #0f172a;
            color: white;
            text-align: center;
            padding: 12px;
            border-radius: 10px;
            font-weight: bold;
        }

        .day {
            background: white;
            border: 1px solid #dbe3ec;
            padding: 10px;
            border-radius: 15px;
            min-height: 140px;
        }

        .day.empty {
            background: #f8fafc;
            border: none;
        }

        .day.today {
            border: 2px solid #6366f1;
            background: #eef2ff;
        }

        .event-box {
            background: white;
            border-left: 4px solid #6366f1;
            border-radius: 10px;
            padding: 8px;
            margin-top: 8px;
            font-size: 13px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.08);
        }

        .event-title {
            font-weight: bold;
            display: block;
        }

        .event-desc {
            color: #64748b;
            font-size: 12px;
        }

        .highlight-search {
            border: 3px solid red !important;
            background: #fff3cd !important;
            transform: scale(1.02);
        }
    </style>

</head>

<body>

    <div class="container mt-5">

        <div class="calendar-container">

            <% const homNay=new Date(); const ngayDauTien=new Date(viewYear, viewMonth - 1, 1).getDay(); const
                soNgayTrongThang=new Date(viewYear, viewMonth, 0).getDate(); %>

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h2 class="fw-bold">

                        Tháng <%= viewMonth %> / <%= viewYear %>

                    </h2>

                    <div class="d-flex gap-2">

                        <a href="/lich?month=<%= viewMonth == 1 ? 12 : viewMonth - 1 %>&year=<%= viewMonth == 1 ? viewYear - 1 : viewYear %>"
                            class="btn btn-outline-primary">

                            <i class="bi bi-chevron-left"></i>

                        </a>

                        <a href="/lich?month=<%= viewMonth == 12 ? 1 : viewMonth + 1 %>&year=<%= viewMonth == 12 ? viewYear + 1 : viewYear %>"
                            class="btn btn-outline-primary">

                            <i class="bi bi-chevron-right"></i>

                        </a>

                        <a href="/" class="btn btn-secondary">
                            Trang chủ
                        </a>

                        <% if(session && (session.QuyenHan==='admin' || session.QuyenHan==='giaovien' )) { %>

                            <a href="/lich/them" class="btn btn-primary">

                                + Thêm lịch

                            </a>

                            <% } %>

                    </div>

                </div>


                <!-- LỊCH -->

                <div class="calendar-grid">

                    <div class="day-name">CN</div>
                    <div class="day-name">T2</div>
                    <div class="day-name">T3</div>
                    <div class="day-name">T4</div>
                    <div class="day-name">T5</div>
                    <div class="day-name">T6</div>
                    <div class="day-name">T7</div>


                    <% for(let x=0; x < ngayDauTien; x++) { %>

                        <div class="day empty"></div>

                        <% } %>


                            <% for(let i=1; i <=soNgayTrongThang; i++) { %>

                                <% let isToday=homNay.getDate()==i && homNay.getMonth() + 1==viewMonth &&
                                    homNay.getFullYear()==viewYear; %>

                                    <div class="day <%= isToday ? 'today' : '' %>">

                                        <strong>

                                            <%= i %>

                                        </strong>


                                        <% for(let index=0; index < lich.length; index++) { %>

                                            <% let item=lich[index]; %>


                                                <% if( item.ngay==i && item.thang==viewMonth && item.nam==viewYear ) {
                                                    %>

                                                    <div class="event-box js-item"
                                                        data-title="<%= item.tieude ? String(item.tieude).toLowerCase() : '' %>"
                                                        data-content="<%= item.noidung ? String(item.noidung).toLowerCase() : '' %>">

                                                        <span class="event-title">

                                                            <%= item.tieude %>

                                                        </span>

                                                        <div class="event-desc">

                                                            <%= item.noidung %>

                                                        </div>


                                                        <% if(session && ( session.QuyenHan==='admin' ||
                                                            session.QuyenHan==='giaovien' )) { %>

                                                            <div class="text-end mt-2">

                                                                <a href="/lich/xoa/<%= index %>" class="text-danger"
                                                                    onclick="return confirm('Xóa sự kiện này?')">

                                                                    <i class="bi bi-trash"></i>

                                                                </a>

                                                            </div>

                                                            <% } %>

                                                    </div>

                                                    <% } %>

                                                        <% } %>

                                    </div>

                                    <% } %>

                </div>

        </div>

    </div>


</body>

</html>