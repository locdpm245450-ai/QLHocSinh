<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quản lý Hạnh kiểm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f1f5f9;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            margin: 0;
        }

        /* SIDEBAR STYLE "ẢNH 2" */
        .sidebar {
            width: 260px;
            height: 100vh;
            background: #1a233a;
            position: fixed;
            padding: 25px 15px;
            z-index: 1000;
        }

        .sidebar h4 {
            color: white;
            font-weight: bold;
            margin-bottom: 30px;
            padding-left: 10px;
        }

        .nav-link {
            color: #a0aec0 !important;
            border-radius: 12px;
            margin-bottom: 8px;
            transition: 0.3s;
            font-weight: 500;
            display: flex;
            align-items: center;
            text-decoration: none;
            padding: 12px 15px;
        }

        .nav-link:hover,
        .nav-link.active {
            background: rgba(255, 255, 255, 0.1) !important;
            color: #ffffff !important;
            border-left: 4px solid #3b82f6;
        }

        .nav-link i {
            margin-right: 12px;
            font-size: 1.2rem;
        }

        /* CONTENT AREA */
        .main-content {
            margin-left: 260px;
            width: calc(100% - 260px);
            padding: 40px;
        }

        .card-custom {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            background: white;
            padding: 30px;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <h4>QL HỌC SINH</h4>
        <nav class="nav flex-column">
            <a href="/admin" class="nav-link"><i class="bi bi-grid-1x2"></i>Tổng quan</a>
            <a href="/hocsinh" class="nav-link"><i class="bi bi-people"></i>Học sinh</a>
            <a href="/lop" class="nav-link"><i class="bi bi-door-open"></i>Lớp học</a>
            <a href="/hanhkiem" class="nav-link active"><i class="bi bi-award"></i>Hạnh kiểm</a>
            <a href="/baitap" class="nav-link"><i class="bi bi-journal-text"></i>Bài tập</a>
            <a href="/diem" class="nav-link"><i class="bi bi-book"></i>Điểm số</a>
            <hr class="text-secondary opacity-25">
            <a href="/dangxuat" class="nav-link text-danger"><i class="bi bi-box-arrow-right"></i>Đăng xuất</a>
        </nav>
    </div>

    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-dark">Quản lý Hạnh kiểm</h2>
            <% if(session.QuyenHan !=='hocsinh' ) { %>
                <a href="/hanhkiem/them" class="btn btn-primary rounded-pill px-4 shadow-sm">+ Thêm hạnh kiểm</a>
                <% } %>
        </div>

        <div class="card-custom">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Học sinh</th>
                            <th>Lớp</th>
                            <th>Học kỳ</th>
                            <th class="text-center">Điểm số</th>
                            <th class="text-center">Xếp loại</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% dsHanhKiem.forEach(function(hk){ %>
                            <tr>
                                <td class="fw-bold">
                                    <%= hk.HoTen %>
                                </td>
                                <td><span class="badge bg-info text-dark rounded-pill">
                                        <%= hk.Lop %>
                                    </span></td>
                                <td>
                                    <%= hk.HocKy %> - <%= hk.NamHoc %>
                                </td>
                                <td class="text-center">
                                    <%= hk.Diem %>
                                </td>
                                <td class="text-center">
                                    <% let color='text-success' ; if(hk.XepLoai==='Yếu' ) color='text-danger' ; else
                                        if(hk.XepLoai==='Trung bình' ) color='text-warning' ; %>
                                        <span class="fw-bold <%= color %>">
                                            <%= hk.XepLoai %>
                                        </span>
                                </td>
                                <td class="text-end">
                                    <a href="/hanhkiem/sua/<%= hk._id %>"
                                        class="btn btn-sm btn-outline-primary rounded-circle"><i
                                            class="bi bi-pencil"></i></a>
                                    <a href="/hanhkiem/xoa/<%= hk._id %>"
                                        class="btn btn-sm btn-outline-danger rounded-circle ms-2"
                                        onclick="return confirm('Xóa hạnh kiểm này?')"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>

</html>