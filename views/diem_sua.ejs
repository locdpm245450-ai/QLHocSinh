<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <title>Sửa điểm</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #eef2f7;
        }

        .box {
            background: white;
            padding: 30px;
            border-radius: 20px;
            margin-top: 40px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
        }
    </style>

</head>

<body>

    <div class="container">

        <div class="box">

            <h1 class="text-center mb-4">
                Sửa điểm học sinh
            </h1>

            <form method="POST" action="/diem/sua/<%= diem._id %>">

                <div class="mb-3">

                    <label>Học sinh</label>

                    <select name="HocSinh" class="form-select">

                        <% hocsinh.forEach(function(hs){ %>

                            <option value="<%= hs._id %>" <%=hs._id==diem.HocSinh ? 'selected' : '' %>
                                >

                                <%= hs.HoTen %>

                            </option>

                            <% }) %>

                    </select>

                </div>

                <div class="mb-3">

                    <label>Môn học</label>

                    <select name="MonHoc" class="form-select">

                        <% monhoc.forEach(function(mh){ %>

                            <option value="<%= mh._id %>" <%=mh._id==diem.MonHoc ? 'selected' : '' %>
                                >

                                <%= mh.TenMon %>

                            </option>

                            <% }) %>

                    </select>

                </div>

                <div class="mb-3">

                    <input type="number" step="0.1" name="DiemMieng" class="form-control" value="<%= diem.DiemMieng %>">

                </div>

                <div class="mb-3">

                    <input type="number" step="0.1" name="Diem15p" class="form-control" value="<%= diem.Diem15p %>">

                </div>

                <div class="mb-3">

                    <input type="number" step="0.1" name="Diem1Tiet" class="form-control" value="<%= diem.Diem1Tiet %>">

                </div>

                <div class="mb-3">

                    <input type="number" step="0.1" name="DiemThi" class="form-control" value="<%= diem.DiemThi %>">

                </div>

                <button class="btn btn-success">
                    Cập nhật
                </button>

                <a href="/diem" class="btn btn-secondary">
                    Quay lại
                </a>

            </form>

        </div>

    </div>

</body>

</html>