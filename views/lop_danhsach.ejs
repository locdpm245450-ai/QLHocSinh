<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Danh sách lớp</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f1f5f9;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            background: #0f172a;
            position: fixed;
            top: 0;
            left: 0;
            padding: 20px;
        }

        .main-content {
            margin-left: 260px;
            padding: 40px;
            width: calc(100% - 260px);
        }

        .nav-link {
            color: #94a3b8;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 5px;
            text-decoration: none;
            display: block;
            transition: .3s;
        }

        .nav-link:hover,
        .nav-link.active {
            background: #1e293b;
            color: white !important;
        }

        .card-box {
            border: none;
            border-radius: 20px;
            background: white;
            box-shadow: 0 4px 20px rgba(0, 0, 0, .05);
        }
    </style>
</head>

<body>

    <div class="sidebar">

        <h4 class="text-white fw-bold mb-4 px-2">
            QL Học Sinh
        </h4>

        <nav class="nav flex-column">

            <a href="/admin" class="nav-link"><i class="bi bi-speedometer2 me-2"></i> Tổng quan</a>

            <a href="/taikhoan" class="nav-link"><i class="bi bi-person-badge me-2"></i> Quản lý tài khoản</a>

            <a href="/hocsinh" class="nav-link"><i class="bi bi-people me-2"></i> Học sinh</a>

            <a href="/monhoc" class="nav-link"><i class="bi bi-book me-2"></i> Môn học</a>

            <a href="/lop" class="nav-link active"><i class="bi bi-door-open me-2"></i> Lớp học</a>

            <a href="/baitap" class="nav-link"><i class="bi bi-journal-text me-2"></i> Bài tập</a>

            <a href="/" class="nav-link"><i class="bi bi-house-door me-2"></i> Trang chủ</a>

            <hr class="text-secondary">

            <a href="/dangxuat" class="nav-link text-danger">
                <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
            </a>

        </nav>

    </div>

    <div class="main-content">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h1 class="fw-bold">
                Quản lý lớp học
            </h1>

            <% if(session.QuyenHan==="admin" || session.QuyenHan==="giaovien" ) { %>

                <a href="/lop/them" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-plus-circle"></i> Thêm lớp
                </a>

                <% } %>

        </div>

        <div class="card-box p-4">

            <h4 class="fw-bold mb-4">
                Danh sách lớp
            </h4>

            <div class="row">

                <% dsLop.forEach(function(item){ %>

                    <div class="col-md-6 mb-4">

                        <div class="border rounded-4 p-4 h-100">

                            <h5 class="fw-bold">
                                <i class="bi bi-mortarboard-fill text-primary"></i>
                                <%= item.TenLop %>
                            </h5>

                            <p class="text-secondary mb-3">
                                Giáo viên:
                                <b>
                                    <%= item.GiaoVien || "Chưa có" %>
                                </b>
                            </p>

                            <div class="d-flex gap-2">

                                <a href="/lop/<%= item._id %>" class="btn btn-success">

                                    Xem lớp

                                </a>

                                <% if(session.QuyenHan==="admin" || session.QuyenHan==="giaovien" ) { %>

                                    <a href="/lop/xoa/<%= item._id %>" class="btn btn-danger"
                                        onclick="return confirm('Xóa lớp này?')">

                                        Xóa

                                    </a>

                                    <% } %>

                            </div>

                        </div>

                    </div>

                    <% }) %>

            </div>

        </div>

    </div>

</body>

</html>