<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8" />
  <title>Thêm lịch thi mới</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <style>
    body {
      background: #f1f5f9;
      display: flex;
      min-height: 100vh;
      font-family: "Segoe UI", sans-serif;
    }

    .sidebar {
      width: 260px;
      background: #0f172a;
      padding: 20px;
      position: fixed;
      height: 100%;
    }

    .main {
      margin-left: 260px;
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 40px;
    }

    .form-card {
      width: 600px;
      background: white;
      padding: 40px;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .form-control {
      border-radius: 10px;
      padding: 10px;
    }

    .nav-link {
      color: #94a3b8;
      display: block;
      padding: 12px;
      text-decoration: none;
      transition: 0.3s;
    }

    .nav-link:hover {
      background: #1e293b;
      color: white;
      border-radius: 8px;
    }
  </style>
</head>

<body>
  <div class="sidebar">
    <h4 class="text-white fw-bold mb-4 px-2">QL Học Sinh</h4>
    <nav class="nav flex-column">
      <a href="/admin" class="nav-link"><i class="bi bi-speedometer2 me-2"></i> Tổng quan</a>
      <a href="/lichthi" class="nav-link"><i class="bi bi-arrow-left me-2"></i> Quay lại</a>
    </nav>
  </div>

  <div class="main">
    <div class="form-card">
      <h3 class="text-center fw-bold text-primary mb-4">➕ Thêm lịch thi</h3>
      <form action="/lichthi/them" method="POST">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-bold">Mã môn [cite: 157]</label>
            <input type="text" name="maMon" class="form-control" placeholder="Ví dụ: COS304" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Tên môn [cite: 157]</label>
            <input type="text" name="tenMon" class="form-control" placeholder="Cấu trúc dữ liệu" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Kỳ thi [cite: 158]</label>
            <input type="text" name="kyThi" class="form-control" placeholder="Học kỳ 2" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Phòng thi [cite: 159]</label>
            <input type="text" name="phongThi" class="form-control" placeholder="A101" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Số lượng [cite: 160]</label>
            <input type="number" name="soLuong" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Ngày thi [cite: 161]</label>
            <input type="date" name="ngayThi" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-bold">Tiết BD [cite: 162]</label>
            <input type="number" name="tietBatDau" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-bold">Số tiết [cite: 162]</label>
            <input type="number" name="soTiet" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-bold">Phòng [cite: 163]</label>
            <input type="text" name="phong" class="form-control" required>
          </div>
        </div>
        <div class="mt-4 text-center">
          <button class="btn btn-primary rounded-pill px-5 fw-bold py-2">THÊM LỊCH THI</button>
        </div>
      </form>
    </div>
  </div>
</body>

</html>