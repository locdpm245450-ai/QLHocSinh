<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quản lý lớp học</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f1f5f9;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            background: #0f172a;
            position: fixed;
            top: 0;
            left: 0;
            padding: 20px;
            z-index: 1000;
            overflow-y: auto;
        }

        .main-content {
            margin-left: 260px;
            flex: 1;
            padding: 40px;
            width: calc(100% - 260px);
        }

        .nav-link {
            color: #94a3b8;
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 6px;
            text-decoration: none;
            display: flex;
            align-items: center;
            transition: .3s;
        }

        .nav-link:hover,
        .nav-link.active {
            background: #1e293b;
            color: white !important;
        }

        .top-box {
            background: white;
            border-radius: 24px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            margin-bottom: 30px;
        }

        .lop-card {
            background: white;
            border-radius: 24px;
            padding: 24px;
            border: none;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
            transition: .25s;
            height: 100%;
        }

        .lop-card:hover {
            transform: translateY(-5px);
        }

        .student-box {
            background: #f8fafc;
            border-radius: 12px;
            padding: 8px 12px;
            margin-bottom: 6px;
            font-size: 13px;
            display: flex;
            align-items: center;
        }

        .student-list {
            max-height: 200px;
            overflow-y: auto;
            padding-right: 5px;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <h4 class="text-white fw-bold mb-4 px-2">QL Học Sinh</h4>
        <nav class="nav flex-column">
            <a href="/admin" class="nav-link"><i class="bi bi-speedometer2 me-2"></i> Tổng quan</a>
            <a href="/hocsinh" class="nav-link"><i class="bi bi-people me-2"></i>Học sinh</a>
            <a href="/diem" class="nav-link"><i class="bi bi-journal-check me-2"></i>Quản lý điểm</a>
            <a href="/lop" class="nav-link active"><i class="bi bi-door-open me-2"></i>Lớp học</a>
            <a href="/" class="nav-link"><i class="bi bi-house-door me-2"></i>Trang chủ</a>
            <hr class="text-secondary">
            <a href="/dangxuat" class="nav-link text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
        </nav>
    </div>

    <div class="main-content">
        <div class="top-box">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold m-0"><i class="bi bi-door-open text-primary me-2"></i>Quản lý lớp học</h2>
                    <p class="text-muted m-0">Xem danh sách lớp và quản lý học sinh theo lớp</p>
                </div>
                <% if(session.QuyenHan==='admin' ) { %>
                    <form action="/lop/them" method="POST" class="d-flex gap-2">
                        <input type="text" name="tenlop" class="form-control rounded-pill px-3"
                            placeholder="Tên lớp mới..." required>
                        <button class="btn btn-primary rounded-pill px-4 fw-bold">+ Thêm lớp</button>
                    </form>
                    <% } %>
            </div>

            <div class="input-group shadow-sm" style="max-width: 500px;">
                <span class="input-group-text bg-white border-0"><i class="bi bi-search text-primary"></i></span>
                <input type="text" id="searchInput" class="form-control border-0"
                    placeholder="Tìm mã học sinh trong các lớp..." onkeyup="searchStudent()">
            </div>
        </div>

        <div class="row g-4">
            <% dsLop.forEach(function(item){ %>
                <div class="col-lg-4 col-md-6">
                    <div class="lop-card">
                        <div class="d-flex justify-content-between mb-3">
                            <div>
                                <h4 class="fw-bold text-primary m-0">
                                    <%= item.TenLop %>
                                </h4>
                                <small class="text-muted">
                                    <%= item.MaLop %> • <%= item.DanhSachHocSinh.length %> học sinh
                                </small>
                            </div>
                            <% if(session.QuyenHan==='admin' ) { %>
                                <a href="/lop/xoa/<%= item._id %>" class="btn btn-sm btn-outline-danger border-0"
                                    onclick="return confirm('Xóa lớp này?')"><i class="bi bi-trash"></i></a>
                                <% } %>
                        </div>

                        <div class="student-list mb-3">
                            <% if(item.DanhSachHocSinh && item.DanhSachHocSinh.length> 0) { %>
                                <% item.DanhSachHocSinh.forEach(function(maHS){ %>
                                    <div class="student-box student-item" data-id="<%= maHS.toLowerCase() %>">
                                        <i class="bi bi-person-fill text-success me-2"></i>
                                        <%= maHS %>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <p class="text-muted small text-center my-3 italic">Chưa có học sinh</p>
                                            <% } %>
                        </div>

                        <% if(session.QuyenHan==='admin' ) { %>
                            <form action="/lop/<%= item._id %>/them-hocsinh" method="POST">
                                <div class="input-group input-group-sm">
                                    <input type="text" name="hocsinh" class="form-control" placeholder="Mã HS..."
                                        required>
                                    <button class="btn btn-success"><i class="bi bi-plus-lg"></i></button>
                                </div>
                            </form>
                            <% } %>
                    </div>
                </div>
                <% }) %>
        </div>
    </div>

    <script>
        function searchStudent() {
            const keyword = document.getElementById("searchInput").value.toLowerCase().trim();
            const students = document.querySelectorAll(".student-item");
            students.forEach(item => {
                const id = item.dataset.id;
                if (keyword && id.includes(keyword)) {
                    item.style.background = "#dbeafe";
                    item.style.border = "1px solid #2563eb";
                } else {
                    item.style.background = "#f8fafc";
                    item.style.border = "none";
                }
            });
        }
    </script>
</body>

</html>