<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sửa bài tập</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f1f5f9;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            background: #0f172a;
            position: fixed;
            top: 0;
            left: 0;
            padding: 20px;
            z-index: 1000;
        }

        .main-content {
            margin-left: 260px;
            flex: 1;
            padding: 40px;
            width: calc(100% - 260px);
        }

        .nav-link {
            color: #94a3b8;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: 0.3s;
        }

        .nav-link:hover,
        .nav-link.active {
            background: #1e293b;
            color: #fff;
        }

        .card-custom {
            border: none;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <h4 class="text-white fw-bold mb-4 px-2">QL Học Sinh</h4>
        <nav class="nav flex-column">

            <a href="/admin" class="nav-link"><i class="bi bi-speedometer2 me-2"></i> Tổng quan</a>
            <a href="/taikhoan" class="nav-link"><i class="bi bi-person-badge me-2"></i> Quản lý tài khoản</a>
            <a href="/hocsinh" class="nav-link "><i class="bi bi-people me-2"></i>Học sinh</a>
            <a href="/monhoc" class="nav-link"><i class="bi bi-book me-2"></i>Môn học</a>
            <a href="/lop" class="nav-link "><i class="bi bi-door-open me-2"></i>Lớp học</a>
            <a href="/baitap" class="nav-link active"><i class="bi bi-journal-text me-2"></i>Bài tập</a>
            <a href="/" class="nav-link"><i class="bi bi-house-door me-2"></i>Trang chủ</a>
            <hr class="text-secondary">
            <a href="/dangxuat" class="nav-link text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
        </nav>
    </div>

    <div class="main-content">
        <div class="card card-form p-5">
            <h1 class="fw-bold text-primary mb-4">Chỉnh sửa bài tập</h1>
            <form action="/baitap/sua/<%= bt._id %>" method="POST">
                <div class="mb-4">
                    <label class="form-label fw-bold">Tên bài tập</label>
                    <input type="text" name="TenBai" class="form-control" value="<%= bt.TenBai %>" required>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Môn học</label>
                        <select name="MonHoc" class="form-select">
                            <% monhoc.forEach(mh=> { %>
                                <option value="<%= mh.TenMon %>" <%=bt.MonHoc===mh.TenMon ? 'selected' : '' %>><%=
                                        mh.TenMon %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Lớp học nhận bài</label>
                        <input type="text" name="Lop" class="form-control" value="<%= bt.Lop %>">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary">Đính kèm tài liệu (Dưới 15MB)</label>
                    <input type="file" name="fileDinhKem" class="form-control">
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Nội dung hướng dẫn</label>
                    <textarea name="NoiDung" class="form-control" rows="6"><%= bt.NoiDung %></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-5 py-3 rounded-pill fw-bold">LƯU THAY ĐỔI</button>
                    <a href="/baitap" class="btn btn-secondary px-5 py-3 rounded-pill">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</body>

</html>