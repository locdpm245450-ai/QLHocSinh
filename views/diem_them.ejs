<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bài tập học tập</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f1f5f9;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar cố định bên trái */
        .sidebar {
            width: 260px;
            height: 100vh;
            background: #0f172a;
            position: fixed;
            top: 0;
            left: 0;
            padding: 20px;
            z-index: 1000;
        }

        /* Phần nội dung chính phải có margin-left bằng chiều rộng sidebar */
        .main-content {
            margin-left: 260px;
            flex: 1;
            padding: 40px;
            width: calc(100% - 260px);
            min-height: 100vh;
        }

        .nav-link {
            color: #94a3b8;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: 0.3s;
            text-decoration: none;
            display: block;
        }

        .nav-link:hover,
        .nav-link.active {
            background: #1e293b;
            color: #fff !important;
        }

        .card-baitap {
            border: none;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            background: white;
        }

        .rounded-pill-custom {
            border-radius: 50px !important;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <h4 class="text-white fw-bold mb-4 px-2">QL Học Sinh</h4>
        <nav class="nav flex-column">

            <a href="/admin" class="nav-link"><i class="bi bi-speedometer2 me-2"></i> Tổng quan</a>
            <a href="/taikhoan" class="nav-link"><i class="bi bi-person-badge me-2"></i> Quản lý tài khoản</a>
            <a href="/hocsinh" class="nav-link "><i class="bi bi-people me-2"></i>Học sinh</a>
            <a href="/diem" class="nav-link"><i class="bi bi-book me-2"></i>Quản lý điểm</a>
            <a href="/monhoc" class="nav-link"><i class="bi bi-book me-2"></i>Môn học</a>
            <a href="/lop" class="nav-link "><i class="bi bi-door-open me-2"></i>Lớp học</a>
            <a href="/baitap" class="nav-link active"><i class="bi bi-journal-text me-2"></i>Bài tập</a>
            <a href="/" class="nav-link"><i class="bi bi-house-door me-2"></i>Trang chủ</a>
            <hr class="text-secondary">
            <a href="/dangxuat" class="nav-link text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>
        </nav>
    </div>

    <div class="main-content">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="fw-bold text-primary mb-0">Bài tập học tập</h1>
                <div class="d-flex gap-2 align-items-center">
                    <select class="form-select shadow-sm" id="locMonHoc" onchange="locBaiTap()"
                        style="width: 200px; border-radius: 12px;">
                        <option value="all">Tất cả môn</option>
                        <% dsMonHoc.forEach(function(mh){ %>
                            <option value="<%= mh.TenMon %>">
                                <%= mh.TenMon %>
                            </option>
                            <% }) %>
                    </select>
                </div>
            </div>

<head>

    <meta charset="UTF-8">

    <title>Thêm điểm</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="bg-light">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand" href="/">
                Quản lý học sinh
            </a>

            <div class="d-flex gap-2">

                <a href="/" class="btn btn-outline-light">
                    🏠 Trang chủ
                </a>

                <% if(session.QuyenHan==='admin' ) { %>

                    <a href="/monhoc/them" class="btn btn-warning">
                        ➕ Thêm môn học
                    </a>

                    <% } %>

                        <a href="/admin" class="btn btn-primary">
                            ⚙ Trang quản trị
                        </a>

            </div>

        </div>
    </nav>

    <div class="container mt-5">

        <div class="card shadow p-4">

            <h2 class="mb-4">
                Thêm điểm học sinh
            </h2>

            <form action="/diem/them" method="POST">

                <div class="mb-3">

                    <label>Học sinh</label>

                    <select name="HocSinh" class="form-control">

                        <% hocsinh.forEach(hs=> { %>

                            <option value="<%= hs._id %>">

                                <%= hs.HoVaTen %>

                            </option>

                            <% }) %>

                    </select>

                </div>

                <div class="mb-3">

                    <label>Môn học</label>

                    <select name="MonHoc" class="form-control">

                        <% monhoc.forEach(mon=> { %>

                            <option value="<%= mon._id %>">

                                <%= mon.TenMon %>

                            </option>

                            <% }) %>

                    </select>

                </div>

                <div class="mb-3">
                    <label>Điểm miệng</label>
                    <input type="number" step="0.1" name="DiemMieng" class="form-control">
                </div>

                <div class="mb-3">
                    <label>Điểm 15 phút</label>
                    <input type="number" step="0.1" name="Diem15Phut" class="form-control">
                </div>

                <div class="mb-3">
                    <label>Điểm 1 tiết</label>
                    <input type="number" step="0.1" name="Diem1Tiet" class="form-control">
                </div>

                <div class="mb-3">
                    <label>Điểm thi</label>
                    <input type="number" step="0.1" name="DiemThi" class="form-control">
                </div>

                <div class="mb-3">

                    <label>Học kỳ</label>

                    <select name="HocKy" class="form-control">
                        <option value="1">Học kỳ 1</option>
                        <option value="2">Học kỳ 2</option>
                    </select>

                </div>

                <div class="mb-3">
                    <label>Năm học</label>
                    <input type="text" name="NamHoc" class="form-control">
                </div>

                <button class="btn btn-success">
                    Thêm điểm
                </button>

            </form>

        </div>

    </div>

</body>

</html>