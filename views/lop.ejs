<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quản lý lớp học</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f1f5f9;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            background: #0f172a;
            position: fixed;
            top: 0;
            left: 0;
            padding: 20px;
            overflow-y: auto;
        }

        .main-content {
            margin-left: 260px;
            width: calc(100% - 260px);
            padding: 40px;
        }

        .nav-link {
            color: #94a3b8;
            padding: 12px 15px;
            border-radius: 10px;
            margin-bottom: 6px;
            text-decoration: none;
            display: block;
            transition: .3s;
        }

        .nav-link:hover,
        .nav-link.active {
            background: #1e293b;
            color: white !important;
        }

        .top-box {
            background: white;
            border-radius: 24px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            margin-bottom: 30px;
        }

        .lop-card {
            background: white;
            border-radius: 24px;
            padding: 24px;
            height: 100%;
            border: none;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
            transition: .25s;
        }

        .lop-card:hover {
            transform: translateY(-5px);
        }

        .student-box {
            background: #f8fafc;
            border-radius: 14px;
            padding: 10px 14px;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .search-box {
            border-radius: 50px;
            overflow: hidden;
        }

        .btn-rounded {
            border-radius: 50px;
        }

        .student-list {
            max-height: 220px;
            overflow-y: auto;
        }
    </style>
</head>

<body>

    <div class="sidebar">
        <h4 class="text-white fw-bold mb-4 px-2">QL Học Sinh</h4>

        <nav class="nav flex-column">

            <a href="/admin" class="nav-link">
                <i class="bi bi-speedometer2 me-2"></i> Tổng quan
            </a>

            <a href="/taikhoan" class="nav-link">
                <i class="bi bi-person-badge me-2"></i> Quản lý tài khoản
            </a>

            <a href="/hocsinh" class="nav-link"><i class="bi bi-people me-2"></i> Học sinh</a>

            <a href="/diem" class="nav-link"><i class="bi bi-book me-2"></i>Quản lý điểm</a>

            <a href="/monhoc" class="nav-link"><i class="bi bi-book me-2"></i> Môn học</a>

            <a href="/lop" class="nav-link active">
                <i class="bi bi-door-open me-2"></i> Lớp học
            </a>

            <a href="/baitap" class="nav-link">
                <i class="bi bi-journal-text me-2"></i> Bài tập
            </a>

            <a href="/" class="nav-link">
                <i class="bi bi-house-door me-2"></i> Trang chủ
            </a>

            <hr class="text-secondary">

            <a href="/dangxuat" class="nav-link text-danger">
                <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
            </a>

        </nav>
    </div>

    <div class="main-content">

        <div class="top-box">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                <div>
                    <h2 class="fw-bold mb-1">
                        <i class="bi bi-door-open text-primary"></i>
                        Quản lý lớp học
                    </h2>

                    <p class="text-muted m-0">
                        Quản lý danh sách lớp và học sinh
                    </p>
                </div>

                <div class="d-flex gap-2">

                    <a href="/lop" class="btn btn-dark btn-rounded">
                        <i class="bi bi-list-ul"></i>
                        Danh sách
                    </a>

                    <% if(session.QuyenHan==='admin' ) { %>

                        <a href="/lop/them" class="btn btn-primary btn-rounded">
                            <i class="bi bi-plus-circle"></i>
                            Thêm lớp
                        </a>

                        <% } %>

                </div>

            </div>

            <div class="row g-3">

                <div class="col-md-8">

                    <div class="input-group search-box shadow-sm">

                        <span class="input-group-text bg-white border-0">
                            <i class="bi bi-search text-primary"></i>
                        </span>

                        <input type="text" id="searchInput" class="form-control border-0"
                            placeholder="Tìm theo mã học sinh...">

                        <button class="btn btn-primary px-4" onclick="searchStudent()">
                            Tìm
                        </button>

                    </div>

                </div>

                <% if(session.QuyenHan==='admin' ) { %>

                    <div class="col-md-4">

                        <form method="POST" action="/lop/them" class="d-flex gap-2">

                            <input type="text" name="tenlop" class="form-control btn-rounded"
                                placeholder="Tên lớp mới..." required>

                            <button class="btn btn-success btn-rounded">
                                +
                            </button>

                        </form>

                    </div>

                    <% } %>

            </div>

        </div>

        <div class="row g-4">

            <% dsLop.forEach(function(item){ %>

                <div class="col-lg-4 col-md-6">

                    <div class="lop-card">

                        <div class="d-flex justify-content-between align-items-start mb-3">

                            <div>

                                <h4 class="fw-bold text-primary mb-1">
                                    <%= item.TenLop %>
                                </h4>

                                <small class="text-muted">
                                    <i class="bi bi-people"></i>
                                    <%= (item.DanhSachHocSinh) ? item.DanhSachHocSinh.length : 0 %> học sinh
                                </small>

                            </div>

                            <% if(session.QuyenHan==='admin' ) { %>

                                <a href="/lop/xoa/<%= item._id %>" class="btn btn-sm btn-danger rounded-circle"
                                    onclick="return confirm('Xóa lớp này?')">
                                    <i class="bi bi-trash"></i>
                                </a>

                                <% } %>

                        </div>

                        <hr>

                        <div class="student-list mb-3">

                            <% if(item.HocSinh.length> 0) { %>

                                <% item.HocSinh.forEach(function(hs){ %>

                                    <div class="student-box student-item" data-id="<%= hs.toLowerCase() %>">

                                        <i class="bi bi-person-fill text-success me-2"></i>

                                        <%= hs %>

                                    </div>

                                    <% }) %>

                                        <% } else { %>

                                            <p class="text-muted">
                                                Chưa có học sinh
                                            </p>

                                            <% } %>

                        </div>

                        <% if(session.QuyenHan==='admin' ) { %>

                            <form method="POST" action="/lop/<%= item._id %>/them-hocsinh">

                                <div class="input-group">

                                    <input type="text" name="hocsinh" class="form-control" placeholder="Mã học sinh..."
                                        required>

                                    <button class="btn btn-success">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>

                                </div>

                            </form>

                            <% } %>

                    </div>

                </div>

                <% }) %>

        </div>

    </div>

    <script>

        function searchStudent() {

            const keyword = document
                .getElementById("searchInput")
                .value
                .toLowerCase()
                .trim();

            const students = document.querySelectorAll(".student-item");

            students.forEach(item => {

                item.style.border = "none";
                item.style.background = "#f8fafc";

                const id = item.dataset.id;

                if (keyword && id.includes(keyword)) {

                    item.style.background = "#dbeafe";
                    item.style.border = "2px solid #2563eb";

                    item.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });

                }

            });

        }

    </script>

</body>

</html>